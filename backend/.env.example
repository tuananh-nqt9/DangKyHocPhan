# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU — BACKEND ĐĂNG KÝ HỌC PHẦN (TV2 - SPEC v3.0)
# Sao chép file này thành backend/.env (hoặc .env ở thư mục gốc khi chạy Compose).
# Tuyệt đối KHÔNG commit file .env chứa secret thật lên Git!
# ==============================================================================

# 1. Môi trường ứng dụng & máy chủ HTTP
# APP_ENV: dev | test | lab | prod (reset dữ liệu chỉ cho phép ở dev/test/lab)
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=2
LOG_LEVEL=INFO

# 2. Kết nối PostgreSQL 16 (nguồn dữ liệu nghiệp vụ duy nhất)
# Lưu ý: TEST_DATABASE_URL PHẢI trỏ vào database riêng (vd: dkhp_test) để không ảnh hưởng DB đang dùng!
DATABASE_URL=postgresql://dkhp_user:dkhp_dev_pass@localhost:5432/dkhp_dev
TEST_DATABASE_URL=postgresql://dkhp_user:dkhp_dev_pass@localhost:5432/dkhp_test

# 3. Cấu hình Pool & Timeout PostgreSQL
# Tổng kết nối tối đa = API_WORKERS * DB_POOL_MAX_SIZE + kết nối CLI/migration/giám sát
# Ví dụ: 2 workers * 10 = 20 kết nối (< max_connections=100 của PostgreSQL 16)
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=3.0
DB_LOCK_TIMEOUT_MS=2000
DB_IDEMPOTENCY_LOCK_TIMEOUT_MS=1500
DB_STATEMENT_TIMEOUT_MS=5000

# 4. Phiên đăng nhập & Opaque Token
# Access token sống tối đa 3600s (1 giờ); phiên tuyệt đối tối đa 28800s (8 giờ từ lúc login)
ACCESS_TOKEN_TTL_SECONDS=3600
SESSION_ABSOLUTE_TTL_SECONDS=28800

# 5. CORS, Origin giao diện TV3 & URL công khai
# Danh sách origin phân tách bằng dấu phẩy; KHÔNG dùng wildcard '*'
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 6. Nghiệp vụ đăng ký, Idempotency & Học phí
IDEMPOTENCY_TTL_SECONDS=86400
TUITION_PER_CREDIT=500000

# 7. Công tắc bật/tắt Feature theo từng đợt bàn giao
# Đợt B: PAYMENTS_ENABLED=true (mặc định bật vì mô phỏng nội bộ trên PostgreSQL)
# Đợt C: SSO_ENABLED=false, QUEUE_ENABLED=false mặc định cho kiểm thử tính đúng & đo tải chuẩn
PAYMENTS_ENABLED=true
SSO_ENABLED=false
QUEUE_ENABLED=false

# 8. Hàng đợi Redis (chỉ dùng khi QUEUE_ENABLED=true)
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1.5
QUEUE_MAX_READY=100
QUEUE_TOKEN_TTL_SECONDS=300
QUEUE_EXPIRED_MARKER_TTL_SECONDS=3600

# 9. SSO Keycloak OIDC Authorization Code + PKCE S256 (chỉ dùng khi SSO_ENABLED=true)
# OIDC_ISSUER: định danh issuer chính xác trong ID token (URL trình duyệt thấy, vd: http://localhost:8081/realms/dkhp)
# OIDC_AUTHORIZATION_ENDPOINT: URL trình duyệt người dùng được 302 tới
# OIDC_TOKEN_ENDPOINT / OIDC_JWKS_URI: URL backend gọi trực tiếp (có thể là hostname nội bộ Docker keycloak:8080)
OIDC_ISSUER=http://localhost:8081/realms/dkhp
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8081/realms/dkhp/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=http://localhost:8081/realms/dkhp/protocol/openid-connect/token
OIDC_JWKS_URI=http://localhost:8081/realms/dkhp/protocol/openid-connect/certs
OIDC_CLIENT_ID=dkhp-backend
OIDC_CLIENT_SECRET=CHANGE_ME_IN_ENV_NOT_COMMITTED
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/sso/callback
OIDC_HTTP_TIMEOUT_SECONDS=5.0
OIDC_TRANSACTION_TTL_SECONDS=300
OIDC_EXCHANGE_CODE_TTL_SECONDS=60
OIDC_COOKIE_SECURE=false

# 10. Rate limit bổ trợ tầng ứng dụng (Nginx của TV1 vẫn là lớp giới hạn chính)
# RATE_LIMIT_BACKEND: none | memory | redis
# Lưu ý: 'memory' chỉ giới hạn cục bộ trên từng worker; dùng 'redis' hoặc Nginx để chia sẻ xuyên worker.
RATE_LIMIT_BACKEND=none
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=200
LOGIN_RATE_LIMIT_PER_MINUTE=60
